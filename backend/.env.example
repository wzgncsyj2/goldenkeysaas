# ============================================================
# 金钥匙智知 - 环境变量配置模板
# 复制为 .env 并填入实际值
# ============================================================

# --- 应用配置 ---
APP_NAME=金钥匙智知
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- 服务端口 ---
API_HOST=0.0.0.0
API_PORT=8000

# --- 数据库配置 ---
# 开发环境 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 生产环境 (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/goldenkey

# --- Redis配置 (可选) ---
# REDIS_URL=redis://localhost:6379/0

# --- JWT认证配置 ---
# 生产环境必须更换为随机字符串！
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM配置 ---
# OpenAI
LLM_API_KEY=sk-your-openai-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# DeepSeek (可选)
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 通义千问 (可选)
# LLM_API_KEY=sk-your-dashscope-api-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo

# --- Embedding配置 ---
# 默认使用OpenAI，可切换为其他兼容API
EMBEDDING_API_KEY=sk-your-openai-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- 向量数据库配置 ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- 文件存储配置 ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- 租户配额 (免费版) ---
FREE_MAX_DOCUMENTS=10
FREE_MAX_STORAGE_MB=100
FREE_MAX_API_CALLS_PER_DAY=100

# --- 邮件通知 (可选) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
